# Only the NEW repository's .env is loaded. Never copy credentials into tracked files.
CONTEXTGUARD_DB=data/contextguard.sqlite3
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=
VEXA_BASE_URL=https://api.cloud.vexa.ai
# Vexa keys are scoped: bot = send/stop bots (vxa_bot_), tx = read transcripts (vxa_tx_).
# Use one combined key in VEXA_API_KEY only if it carries both scopes; otherwise set both below.
VEXA_API_KEY=
VEXA_BOT_KEY=
VEXA_TX_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:8027/api/slack/callback
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# Optional selected fictional test sources for scripts/verify_live.py.
# No source is read/joined without explicit CLI flags and authorization.
VEXA_TEST_PLATFORM=
VEXA_TEST_MEETING_ID=
VEXA_TEST_PASSCODE=
SLACK_TEST_CHANNEL_ID=
SLACK_TEST_THREAD_TS=
